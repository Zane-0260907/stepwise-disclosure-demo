ols\":[{\"type\":\"function\",\"function\":{\"name\":\"submit_calculation\",\"description\":\"Submit the complete calculation as a finite program. It executes locally. Use field IDs for source values, never guessed or remembered values. Each step has two arguments; step references are zero-based and backward only. The last step is the numerical answer. Return proportions as fractions (e.g. 0.25, not 25) unless the question explicitly asks for a percentage-point difference.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"program\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":8,\"items\":{\"type\":\"object\",\"properties\":{\"op\":{\"type\":\"string\",\"enum\":[\"add\",\"subtract\",\"multiply\",\"divide\",\"min\",\"max\"]},\"args\":{\"type\":\"array\",\"minItems\":2,\"maxItems\":2,\"items\":{\"type\":\"object\",\"properties\":{\"field\":{\"type\":\"string\"},\"constant\":{\"type\":\"number\"},\"step\":{\"type\":\"integer\",\"minimum\":0}},\"additionalProperties\":false}}},\"required\":[\"op\",\"args\"],\"additionalProperties\":false}}},\"required\":[\"program\"],\"additionalProperties\":false}}}],\"tool_choice\":{\"type\":\"function\",\"function\":{\"name\":\"submit_calculation\"}}}",
