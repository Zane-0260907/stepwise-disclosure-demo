ols\":[{\"type\":\"function\",\"function\":{\"name\":\"request_cells\",\"description\":\"Request the numeric cells actually needed to construct this calculation. Values are held locally. Choose by the question and row/column labels, not guessed values. One request only.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"enum\":[\"r1c1\",\"r1c2\",\"r2c1\",\"r2c2\"]},\"minItems\":1,\"maxItems\":12,\"uniqueItems\":true}},\"required\":[\"fields\"],\"additionalProperties\":false}}}],\"tool_choice\":{\"type\":\"function\",\"function\":{\"name\":\"request_cells\"}}}",
